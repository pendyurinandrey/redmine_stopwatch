<div id="stopwatch-widget"
     data-state="<%= timer.state %>"
     data-elapsed-seconds="<%= timer.elapsed_seconds %>"
     data-started-at="<%= timer.started_at&.utc&.iso8601 %>"
     data-accumulated-seconds="<%= timer.accumulated_seconds %>"
     data-start-url="<%= stopwatch_start_path %>"
     data-stop-url="<%= stopwatch_stop_path %>"
     data-recent-url="<%= stopwatch_recent_path %>"
     data-segments-url="<%= stopwatch_segments_path %>"
     data-timer-issue-id="<%= timer_context[:id] %>"
     data-timer-issue-subject="<%= timer_context[:subject] %>"
     data-timer-issue-url="<%= timer_context[:url] %>"
     data-page-issue-id="<%= page_context[:id] %>"
     data-page-issue-subject="<%= page_context[:subject] %>"
     data-page-issue-url="<%= page_context[:url] %>"
     data-page-can-track="<%= page_context[:can_track] ? '1' : '0' %>"
     data-pending-count="<%= pending_count %>"
     data-user-id="<%= User.current.id %>"
     data-i18n="<%= i18n.to_json %>">
</div>
